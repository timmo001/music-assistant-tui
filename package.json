{
  "name": "music-assistant-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/music-assistant-tui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0 .",
    "test": "bun test",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.yml\" \".scripts/**/*.yaml\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.yml\" \".scripts/**/*.yaml\"",
    "check:shell": "bash -n .scripts/linux/*.sh",
    "check:package": ".scripts/linux/prepare-aur-git.sh /tmp/music-assistant-tui-aur-git && test -f /tmp/music-assistant-tui-aur-git/PKGBUILD"
  },
  "dependencies": {
    "@opentui/core": "^0.5.0",
    "effect": "4.0.0-rc.117",
    "fuse.js": "^7.5.0",
    "jimp": "1.6.1",
    "multicast-dns": "7.2.5"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.45.0",
    "@oxlint/plugins": "1.85.0",
    "@timmo001/oxlint-rules": "0.3.5",
    "@types/bun": "^1.3.14",
    "@types/multicast-dns": "7.2.4",
    "oxlint": "1.85.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
