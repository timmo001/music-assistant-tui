{
  "name": "music-assistant-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --force=false",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/music-assistant-tui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "bun test",
    "ci": "bun run --parallel --no-exit-on-error format:check lint typecheck test build",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.yml\" \".scripts/**/*.yaml\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.yml\" \".scripts/**/*.yaml\"",
    "check:shell": "bash -n .scripts/linux/*.sh",
    "check:package": ".scripts/linux/prepare-aur-git.sh /tmp/music-assistant-tui-aur-git && test -f /tmp/music-assistant-tui-aur-git/PKGBUILD"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@opentui/core": "^0.6.0",
    "effect": "4.0.6",
    "fuse.js": "^7.5.0",
    "jimp": "1.6.1",
    "multicast-dns": "7.2.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.1",
    "@oxlint/plugins": "1.89.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "^1.4.2",
    "@types/multicast-dns": "7.2.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
