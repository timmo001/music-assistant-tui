{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)mise\\.toml$/",
        "/^\\.github/workflows/release\\.yml$/",
        "/^\\.scripts/linux/PKGBUILD$/",
        "/^src/sendspin/process\\.ts$/",
        "/^README\\.md$/",
        "/^THIRD_PARTY_NOTICES\\.md$/"
      ],
      "matchStrings": [
        "s3than/sendspin-rs-cli/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "SUPPORTED_VERSION = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "sendspin-rs-cli`? (v|on `PATH` or `SENDSPIN_PLAYER_BINARY` pointing to its v)(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "s3than/sendspin-rs-cli",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["effect"],
      "ignoreUnstable": false,
      "minimumReleaseAge": null
    }
  ]
}
